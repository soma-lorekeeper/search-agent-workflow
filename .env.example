OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4

# lorekeeper-poc(../lorekeeper-poc를 clone한 lorekeeper-poc/ 폴더) docker-compose.yml의
# NEO4J_AUTH=neo4j/lorekeeper와 반드시 일치해야 한다.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lorekeeper
# 선택값 — 지정 안 하면 lorekeeper 기본값(gpt-5.6-luna / high) 사용
# LOREKEEPER_MODEL=gpt-5.6-luna
# LOREKEEPER_REASONING=high
