# `.env` 로 복사해서 쓴다. `.env` 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 프로덕션에서는 이 파일을 쓰지 않는다. 배포 스크립트(mvp-infra-iac 의
# deploy-agent-remote.sh)가 SSM/Secrets Manager 에서 값을 읽어
# /opt/agent/agent.env 를 만들고 systemd 가 그걸 주입한다.
# 그래서 프로덕션 자격증명은 어느 레포에도 남지 않는다.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4

# 인덱싱 접수 시 확인하는 분당 토큰(TPM) 한도. 조직의 실제 OpenAI TPM 한도에 맞춘다 —
# 이 값을 넘길 것으로 추정되는 요청은 접수 자체를 거절한다(429 + Retry-After).
# 지정 안 하면 200000.
# INDEX_TPM_LIMIT=200000

# ---------- 그래프 DB (Neo4j) ----------
# 로컬은 docker-compose.yml 이 띄우는 컨테이너.
# 프로덕션은 별도 EC2 이고, 주소는 사설 IP 라 외부에서 접근할 수 없다.
#
# ⚠️ API 서버(lorekeeper-backend)의 compose.dev.yml 도 같은 포트(7474/7687)에 Neo4j 를
# 띄운다. 둘을 동시에 올리면 포트가 충돌하니 **한쪽만** 띄우고 다른 쪽은 그것을 가리킨다.
# 그쪽은 아직 5.26 이고 여기는 2026.07 이다 — 우리 인덱싱이 쓰는 인덱스·필터가 2026 계열
# 전제라, 그래프를 실제로 쓰는 이쪽 compose 로 띄우는 편이 안전하다.
# (API 서버는 Neo4j 를 헬스체크로만 읽고 쓰기는 하지 않는다.)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lorekeeper
# 접속할 데이터베이스. Community 는 표준 DB 가 하나뿐이라 보통 기본값 그대로 둔다.
# NEO4J_DATABASE=neo4j

# ---------- 관계형 DB (PostgreSQL) ----------
# **API 서버(lorekeeper-backend)와 같은 DB 다.** 원고·작품을 읽고 탐지 결과를 그쪽
# 테이블(detection_jobs / detection_findings)에 직접 쓴다.
#
# 형식이 서로 다르니 주의 — 같은 곳을 가리켜야 한다.
#   Spring : SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/lorekeeper
#            SPRING_DATASOURCE_USERNAME / _PASSWORD  (세 변수로 분리)
#   여기   : DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lorekeeper  (하나에 포함)
#
# 로컬은 양쪽 레포의 compose 가 같은 포트·계정(lorekeeper/lorekeeper)을 쓰므로,
# 둘 중 어느 쪽 compose 로 띄워도 같은 DB 를 본다.
# 프로덕션은 RDS 이고, 비밀번호는 RDS 가 Secrets Manager 에서 관리·회전한다.
DATABASE_URL=postgresql://lorekeeper:lorekeeper@localhost:5432/lorekeeper

# 인덱싱(그래프 추출)용 모델과 추론 강도. 지정 안 하면 gpt-5.6-luna / high.
# 탐지·채팅은 위의 OPENAI_MODEL 을 쓴다 — 추출은 스키마를 채우는 일이라 모델을 따로 잡는다.
# LOREKEEPER_MODEL=gpt-5.6-luna
# LOREKEEPER_REASONING=high
